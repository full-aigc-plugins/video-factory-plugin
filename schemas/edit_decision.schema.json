{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://partme.ai/schemas/vedio/edit-decision-1.0.0.json",
  "title":"EditDecision","type":"object","additionalProperties":false,
  "required":["schemaVersion","id","revision","timebase","clips"],
  "properties":{
    "schemaVersion":{"type":"string","const":"1.0.0"},
    "id":{"type":"string","minLength":1},
    "revision":{"type":"integer","minimum":1},
    "timebase":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],"properties":{"numerator":{"type":"integer","minimum":1},"denominator":{"type":"integer","minimum":1}}},
    "clips":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["id","assetId","sourceInTicks","sourceOutTicks","timelineInTicks","track","transition","gainDb"],"properties":{"id":{"type":"string","pattern":"^C[0-9]{2,4}$"},"assetId":{"type":"string","minLength":1},"sourceInTicks":{"type":"integer","minimum":0},"sourceOutTicks":{"type":"integer","minimum":1},"timelineInTicks":{"type":"integer","minimum":0},"track":{"type":"integer","minimum":0,"maximum":16},"transition":{"type":"string","enum":["cut","fade","dissolve"]},"gainDb":{"type":"number","minimum":-60,"maximum":12}}}}
  }
}
