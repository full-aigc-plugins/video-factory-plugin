{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/vedio/video-plan-1.0.0.json",
  "title": "VideoPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "mode", "round", "editDecision", "assets", "output"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "const": "local_composition"},
    "round": {"type": "integer", "minimum": 1},
    "editDecision": {"type": "object"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "kind": {"type": "string", "enum": ["image", "video", "audio", "subtitle"]},
          "durationTicks": {"type": "integer", "minimum": 1},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "authorizedAt": {"type": "string", "minLength": 1},
          "receiptPath": {"type": "string", "minLength": 1}
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "width", "height", "fps", "requireAudio"],
      "properties": {
        "aspect": {"type": "string", "enum": ["16:9", "9:16", "1:1"]},
        "width": {"type": "integer", "minimum": 2},
        "height": {"type": "integer", "minimum": 2},
        "fps": {"type": "number", "minimum": 1, "maximum": 120},
        "requireAudio": {"type": "boolean"},
        "audioAssetId": {"type": "string", "minLength": 1},
        "subtitleAssetId": {"type": "string", "minLength": 1},
        "watermarkAssetId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "maxLength": 200}
      }
    }
  }
}
